# Copy to .env.local and adjust.

# 'dev'   -> HTTP Basic against the Spring dev profile (penpal/parent_helper/monitor/admin)
# 'auth0' -> real Auth0 login + bearer JWT
VITE_AUTH_MODE=dev

# API base path (vite proxies /api -> http://localhost:8080 in dev).
# Endpoints include their controller prefix, e.g. /users/me, /penpal/monitors/all-users.
VITE_API_BASE=/api

# Only used when VITE_AUTH_MODE=auth0
VITE_AUTH0_DOMAIN=YOUR-TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier
